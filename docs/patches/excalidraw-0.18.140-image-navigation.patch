index 0000000..70aa874
--- /dev/null
+++ b/packages/element/tests/imageZoomRenderer.test.ts
@@ -0,0 +1,172 @@
+/** zsviczian -- Author: WolfExplode. Exercise the real renderer cache/export branches. */
+import rough from "roughjs/bin/rough";
+import { describe, expect, it } from "vitest";
+import { getDefaultAppState } from "@excalidraw/excalidraw/appState";
+
+import type {
+  StaticCanvasRenderConfig,
+  RenderableElementsMap,
+} from "@excalidraw/excalidraw/scene/types";
+import type { StaticCanvasAppState, Zoom } from "@excalidraw/excalidraw/types";
+
+import { newImageElement } from "../src/newElement";
+import { elementWithCanvasCache, renderElement } from "../src/renderElement";
+import { getImageZoomCache } from "../src/imageZoomCache";
+
+import type { FileId } from "../src/types";
+
+import type { NonDeletedSceneElementsMap } from "../src/types";
+
+const setup = () => {
+  const element = newImageElement({
+    type: "image",
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 80,
+    fileId: "original" as FileId,
+    status: "saved",
+  });
+  const image = document.createElement("img");
+  Object.defineProperties(image, {
+    naturalWidth: { value: 100 },
+    naturalHeight: { value: 80 },
+  });
+  const canvas = document.createElement("canvas");
+  const context = canvas.getContext("2d")!;
+  const elements = new Map([
+    [element.id, element],
+  ]) as unknown as RenderableElementsMap;
+  const config: StaticCanvasRenderConfig = {
+    imageCache: new Map([[element.fileId!, { image, mimeType: "image/png" }]]),
+    canvasBackgroundColor: "#fff",
+    renderGrid: false,
+    isExporting: false,
+    embedsValidationStatus: new Map(),
+    elementsPendingErasure: new Set(),
+    pendingFlowchartNodes: null,
+    theme: "light",
+  };
+  const draw = (zoom: number) =>
+    renderElement(
+      element,
+      elements,
+      elements as unknown as NonDeletedSceneElementsMap,
+      rough.canvas(canvas),
+      context,
+      config,
+      {
+        ...getDefaultAppState(),
+        zoom: { value: zoom } as Zoom,
+      } as unknown as StaticCanvasAppState,
+    );
+  return {
+    element,
+    image,
+    context,
+    config,
+    draw,
+    cache: getImageZoomCache(config.imageCache),
+  };
+};
+
+describe("image zoom cache renderer integration", () => {
+  it("does not queue an original draw while prepared pixels are pending, and exports bypass readiness", () => {
+    const { config, context, image, draw, element } = setup();
+    let calls = 0;
+    config.imageRenderSourceProvider = () => {
+      calls++;
+      return null;
+    };
+    draw(0.1);
+    const draws = (
+      elementWithCanvasCache.get(element)!.canvas.getContext("2d")!
+        .drawImage as unknown as { mock: { calls: unknown[][] } }
+    ).mock.calls;
+    expect(draws.some((args) => args[0] === image)).toBe(false);
+    expect(calls).toBe(1);
+    config.isExporting = true;
+    draw(1);
+    expect(calls).toBe(1);
+    expect(context.drawImage).toHaveBeenLastCalledWith(
+      image,
+      0,
+      0,
+      100,
+      80,
+      0,
+      0,
+      100,
+      80,
+    );
+  });
+  it("replaces loading pixels with ready pixels at the same zoom without drawing the original", () => {
+    const { config, image, draw, element } = setup();
+    const ready = document.createElement("canvas");
+    ready.width = 80;
+    ready.height = 40;
+    let pending = true;
+    config.imageRenderSourceProvider = () =>
+      pending ? null : (ready as unknown as ImageBitmap);
+    draw(0.1);
+    const loading = elementWithCanvasCache.get(element);
+    pending = false;
+    draw(0.1);
+    const loaded = elementWithCanvasCache.get(element)!;
+    expect(loaded).not.toBe(loading);
+    const context = loaded.canvas.getContext("2d")!;
+    expect(context.drawImage).toHaveBeenLastCalledWith(
+      ready,
+      0,
+      0,
+      80,
+      40,
+      0,
+      0,
+      100,
+      80,
+    );
+    const draws = (
+      context.drawImage as unknown as { mock: { calls: unknown[][] } }
+    ).mock.calls;
+    expect(draws.some((args) => args[0] === image)).toBe(false);
+  });
+  it("reuses a band and revisits older pixels, but replaces changed pixels at the same zoom", () => {
+    const { element, draw, cache, config } = setup();
+    draw(0.1);
+    const low = elementWithCanvasCache.get(element);
+    draw(0.12);
+    expect(elementWithCanvasCache.get(element)).toBe(low);
+    draw(0.3);
+    expect(elementWithCanvasCache.get(element)).not.toBe(low);
+    draw(0.1);
+    expect(elementWithCanvasCache.get(element)).toBe(low);
+    config.imageCache.get(element.fileId!)!.image =
+      document.createElement("img");
+    draw(0.1);
+    expect(elementWithCanvasCache.get(element)).not.toBe(low);
+    expect(cache.stats()).toMatchObject({ generated: 3, hits: 2 });
+  });
+
+  it("exports the original directly without generating or using tier canvases", () => {
+    const { element, image, context, config, draw, cache } = setup();
+    draw(0.1);
+    const stats = cache.stats();
+    const retained = elementWithCanvasCache.get(element);
+    config.isExporting = true;
+    draw(1);
+    expect(cache.stats()).toEqual(stats);
+    expect(elementWithCanvasCache.get(element)).toBe(retained);
+    expect(context.drawImage).toHaveBeenLastCalledWith(
+      image,
+      0,
+      0,
+      100,
+      80,
+      0,
+      0,
+      100,
+      80,
+    );
+  });
+});
