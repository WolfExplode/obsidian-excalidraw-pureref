@@ -0,0 +1,38 @@
+/**
+ * zsviczian -- Display pixels for smooth navigation on large reference Boards.
+ * Author: WolfExplode. The host owns bitmap generation/lifetime; this seam belongs
+ * in the renderer because replacing BinaryFiles would also affect saves/exports.
+ * Original image dimensions remain authoritative for crop and editing geometry.
+ */
+/** zsviczian -- null means loading; undefined deliberately selects the native source. */
+export type ImageRenderSourceProvider = (request: {
+  fileId: string;
+  pixelWidth: number;
+  pixelHeight: number;
+  naturalWidth: number;
+  naturalHeight: number;
+}) => ImageBitmap | null | undefined;
+
+export const getImageRenderSource = (
+  original: HTMLImageElement,
+  proxy: ImageBitmap | null | undefined,
+  isExporting: boolean,
+) => {
+  if (!isExporting && proxy === null) {
+    return { image: null, scaleX: 1, scaleY: 1 };
+  }
+  if (
+    isExporting ||
+    !proxy?.width ||
+    !proxy.height ||
+    !original.naturalWidth ||
+    !original.naturalHeight
+  ) {
+    return { image: original, scaleX: 1, scaleY: 1 };
+  }
+  return {
+    image: proxy,
+    scaleX: proxy.width / original.naturalWidth,
+    scaleY: proxy.height / original.naturalHeight,
+  };
+};
diff --git a/packages/element/src/imageZoomCache.ts b/packages/element/src/imageZoomCache.ts
new file mode 100644
index 0000000..b53f3b5
--- /dev/null
+++ b/packages/element/src/imageZoomCache.ts
@@ -0,0 +1,142 @@
+/**
+ * zsviczian -- Reuse image render canvases across zoom bands on dense Boards.
+ * Author: WolfExplode. See the host's image-lod-attribution-trial investigation.
+ * Source proxies cannot prevent exact-zoom render-cache invalidation.
+ * The budget bounds retained references, not all browser/GPU memory: upstream
+ * may separately hold its current canvas after an LRU entry is evicted.
+ */
+interface CanvasEntry {
+  canvas: { width: number; height: number };
+}
+interface RecordEntry<T> {
+  signature: readonly unknown[];
+  selected: T | undefined;
+  tiers: Map<number, Retained<T>>;
+}
+interface Retained<T> {
+  record: RecordEntry<T>;
+  tier: number;
+  value: T;
+  bytes: number;
+}
+
+/** Round up to sqrt(2) bands; retained pixels meet the requested detail. */
+export const imageCacheZoom = (zoom: number): number =>
+  zoom > 0 && Number.isFinite(zoom)
+    ? 2 ** (Math.ceil(Math.log2(zoom) * 2 - 1e-10) / 2)
+    : zoom;
+
+export class ImageZoomCache<T extends CanvasEntry> {
+  private records = new WeakMap<object, RecordEntry<T>>();
+  private retained = new Set<Retained<T>>();
+  private bytes = 0;
+  private hits = 0;
+  private generated = 0;
+  private evictions = 0;
+  // A dense Board needs multiple bands per image. Keep the count guard well
+  // above one Board's image count; pixel bytes remain the primary budget.
+  constructor(private budget = 128 * 1024 * 1024, private maxEntries = 4096) {}
+
+  /** Missing/replaced upstream entries invalidate tiers instead of reviving stale pixels. */
+  get(
+    element: object,
+    tier: number,
+    previous: T | undefined,
+    signature: readonly unknown[],
+  ): { value?: T; invalidated: boolean } {
+    let record = this.records.get(element);
+    const invalidated =
+      !record ||
+      !previous ||
+      record.selected !== previous ||
+      record.signature.length !== signature.length ||
+      record.signature.some(
+        (value, index) => !Object.is(value, signature[index]),
+      );
+    if (invalidated || !record) {
+      if (record) {
+        for (const entry of record.tiers.values()) {
+          this.remove(entry);
+        }
+      }
+      record = { signature, selected: previous, tiers: new Map() };
+      this.records.set(element, record);
+    }
+    const entry = record.tiers.get(tier);
+    if (!entry) {
+      return { invalidated };
+    }
+    this.hits++;
+    this.retained.delete(entry);
+    this.retained.add(entry);
+    record.selected = entry.value;
+    return { value: entry.value, invalidated };
+  }
+
+  put(element: object, tier: number, value: T): void {
+    this.generated++;
+    const record = this.records.get(element);
+    if (!record) {
+      return;
+    }
+    record.selected = value;
+    const existing = record.tiers.get(tier);
+    if (existing) {
+      this.remove(existing);
+    }
+    const bytes = value.canvas.width * value.canvas.height * 4;
+    if (!(bytes > 0) || bytes > this.budget) {
+      return;
+    }
+    while (
+      this.retained.size &&
+      (this.bytes + bytes > this.budget ||
+        this.retained.size >= this.maxEntries)
+    ) {
+      this.evictions++;
+      this.remove(this.retained.values().next().value!);
+    }
+    const entry = { record, tier, value, bytes };
+    record.tiers.set(tier, entry);
+    this.retained.add(entry);
+    this.bytes += bytes;
+  }
+
+  clear(): void {
+    this.records = new WeakMap();
+    this.retained.clear();
+    this.bytes = 0;
+    this.hits = this.generated = this.evictions = 0;
+  }
+  stats() {
+    return {
+      entries: this.retained.size,
+      bytes: this.bytes,
+      hits: this.hits,
+      generated: this.generated,
+      evictions: this.evictions,
+    };
+  }
+  private remove(entry: Retained<T>): void {
+    entry.record.tiers.delete(entry.tier);
+    this.retained.delete(entry);
+    this.bytes -= entry.bytes;
+  }
+}
+
+// Each editor's imageCache owns its tier cache; Boards and Popouts never share it.
+const caches = new WeakMap<object, ImageZoomCache<CanvasEntry>>();
+export const getImageZoomCache = <T extends CanvasEntry>(
+  owner: object,
+): ImageZoomCache<T> => {
+  let cache = caches.get(owner);
+  if (!cache) {
+    cache = new ImageZoomCache();
+    caches.set(owner, cache);
+  }
+  return cache as ImageZoomCache<T>;
+};
+export const clearImageZoomCache = (owner: object): void => {
+  caches.get(owner)?.clear();
+  caches.delete(owner);
+};
