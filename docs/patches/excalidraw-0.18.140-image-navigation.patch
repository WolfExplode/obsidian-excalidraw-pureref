+++ b/packages/element/tests/imageRenderSource.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+
+import { getImageRenderSource } from "../src/imageRenderSource";
+
+describe("display-only image source", () => {
+  const original = {
+    naturalWidth: 4000,
+    naturalHeight: 3000,
+  } as HTMLImageElement;
+  const proxy = { width: 320, height: 240 } as ImageBitmap;
+
+  it("maps original crop pixels to the smaller bitmap", () => {
+    const display = getImageRenderSource(original, proxy, false);
+    expect(display.image).toBe(proxy);
+    expect(1000 * display.scaleX).toBe(80);
+    expect(1500 * display.scaleY).toBe(120);
+  });
+
+  it("always uses originals for export", () => {
+    expect(getImageRenderSource(original, proxy, true)).toEqual({
+      image: original,
+      scaleX: 1,
+      scaleY: 1,
+    });
+  });
+
+  it("falls back to the original for absent or closed proxies", () => {
+    expect(getImageRenderSource(original, undefined, false).image).toBe(
+      original,
+    );
+    expect(
+      getImageRenderSource(
+        original,
+        { width: 0, height: 0 } as ImageBitmap,
+        false,
+      ).image,
+    ).toBe(original);
+  });
+
+  it("restores the crop aspect when the bounded proxy is square", () => {
+    const display = getImageRenderSource(
+      original,
+      { width: 320, height: 320 } as ImageBitmap,
+      false,
+    );
+    expect(1000 * display.scaleX).toBe(80);
+    expect(1500 * display.scaleY).toBe(160);
+  });
+});
diff --git a/packages/element/tests/imageZoomCache.test.ts b/packages/element/tests/imageZoomCache.test.ts
new file mode 100644
index 0000000..e49cef2
--- /dev/null
+++ b/packages/element/tests/imageZoomCache.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+
+import { ImageZoomCache, imageCacheZoom } from "../src/imageZoomCache";
+
+const canvas = (side = 2) => ({ canvas: { width: side, height: side } });
+
+describe("image render zoom cache", () => {
+  it("retains more than one dense Board of small canvases under the byte budget", () => {
+    const cache = new ImageZoomCache();
+    for (let index = 0; index < 1200; index++) {
+      const element = {};
+      cache.get(element, 1, undefined, []);
+      cache.put(element, 1, canvas());
+    }
+    expect(cache.stats()).toMatchObject({ entries: 1200, evictions: 0 });
+  });
+  it("groups nearby zooms without generating less detail than requested", () => {
+    expect(imageCacheZoom(0.1)).toBe(imageCacheZoom(0.12));
+    expect(imageCacheZoom(1)).toBe(1);
+    for (const zoom of [0.03, 0.1, 0.7, 1, 1.01, 3.9, 10]) {
+      expect(imageCacheZoom(zoom)).toBeGreaterThanOrEqual(zoom);
+      expect(imageCacheZoom(zoom)).toBeLessThan(zoom * Math.SQRT2 + 1e-9);
+    }
+  });
+
+  it("reuses an earlier tier after zooming out and back in", () => {
+    const cache = new ImageZoomCache();
+    const element = {};
+    const low = canvas();
+    const high = canvas(4);
+    cache.get(element, 1, undefined, ["pixels"]);
+    cache.put(element, 1, low);
+    expect(cache.get(element, 2, low, ["pixels"]).value).toBeUndefined();
+    cache.put(element, 2, high);
+    expect(cache.get(element, 1, high, ["pixels"]).value).toBe(low);
+    expect(cache.get(element, 2, low, ["pixels"]).value).toBe(high);
+  });
+
+  it("does not revive pixels after upstream invalidation or changed render inputs", () => {
+    for (const previousMissing of [true, false]) {
+      const cache = new ImageZoomCache();
+      const element = {};
+      const image = canvas();
+      cache.get(element, 1, undefined, ["original", 1]);
+      cache.put(element, 1, image);
+      const result = cache.get(
+        element,
+        1,
+        previousMissing ? undefined : image,
+        previousMissing ? ["original", 1] : ["replacement", 2],
+      );
+      expect(result).toEqual({ invalidated: true });
+      expect(cache.stats().entries).toBe(0);
+    }
+  });
+
+  it("bounds retained bytes and evicts the least recently used tier", () => {
+    const cache = new ImageZoomCache(32);
+    const element = {};
+    const a = canvas();
+    const b = canvas();
+    const c = canvas();
+    cache.get(element, 1, undefined, []);
+    cache.put(element, 1, a);
+    cache.get(element, 2, a, []);
+    cache.put(element, 2, b);
+    cache.get(element, 1, b, []);
+    cache.get(element, 3, a, []);
+    cache.put(element, 3, c);
+    expect(cache.get(element, 2, c, []).value).toBeUndefined();
+    expect(cache.get(element, 1, c, []).value).toBe(a);
+    expect(cache.stats()).toMatchObject({
+      entries: 2,
+      bytes: 32,
+      evictions: 1,
+    });
+  });
+
+  it("does not retain an oversized canvas and clears deterministically", () => {
+    const cache = new ImageZoomCache(16, 1);
+    const element = {};
+    const image = canvas(3);
+    cache.get(element, 1, undefined, []);
+    cache.put(element, 1, image);
+    expect(cache.stats().bytes).toBe(0);
+    cache.clear();
+    expect(cache.get(element, 1, image, []).invalidated).toBe(true);
+  });
+});
diff --git a/packages/element/tests/imageZoomRenderer.test.ts b/packages/element/tests/imageZoomRenderer.test.ts
